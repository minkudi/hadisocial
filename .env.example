# ============================================================
# Modèle de configuration — bk-ebanking-v2
# Copiez ce fichier en ".env" et remplissez vos valeurs locales.
# Les fichiers .env* sont ignorés par Git : jamais poussés sur GitHub.
# ============================================================

# ---------- Base de données (nouvelle base dédiée à la v2) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=<votre_user_mysql>
DB_PASSWORD=<votre_mot_de_passe_mysql>
DB_NAME=<nom_de_la_nouvelle_base_ex: bk_ebanking_v2>

# ---------- SMTP (e-mails transactionnels) ----------
SMTP_HOST=<ex: smtp.gmail.com>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<votre_email_smtp>
SMTP_PASS=<votre_mot_de_passe_smtp>
SMTP_FROM=<ex: "SCAP BEN" <no-reply@scap-ben.com>>

# ---------- SMS (SMSWorks) ----------
SMS_WORKS_URL=<url_de_l_api_sms>
SMS_WORKS_JWT=<votre_jeton_smsworks>
SMS_WORKS_SENDER=SCAPBEN

# ---------- Anti-fraude (FraudLabs, optionnel) ----------
FRAUDLABS_ENABLED=false
FRAUDLABS_API_KEY=<cle_api_fraudlabs_si_active>

# ---------- Application ----------
APP_BASE_URL=http://localhost:3000

# ---------- Notifications admin ----------
ADMIN_NAME=<nom_de_l_admin_notifie>
ADMIN_EMAIL=<email_de_l_admin>
ADMIN_NOTIFY_EMAIL=<email_recevant_les_notifications>
ADMIN_PHONE=<telephone_recevant_les_sms_admin>
